#!/usr/bin/env bash
# playa — operate CLI for playa.lab980.com (Playa.Earth).
#
# A proxied app site: nginx fronts a pm2-managed Node process (Express +
# Prisma/SQLite) on 127.0.0.1:<PORT>, where PORT is whatever provision-site
# wrote into ./.env. Bring-up is `provision-site` (see lab980's CLAUDE.md);
# this script owns everything after that:
#
#   playa deploy    sync to origin/main -> npm ci -> migrate -> build -> pm2 start/restart -> probe -> save
#   playa redeploy  the same (kept as an alias — it was the old name)
#   playa restart   pm2 restart + probe, no code change
#   playa logs      tail the pm2 logs for this app
#   playa status    HEAD, pm2 state, .env key presence, local + public probe, cert days
#   playa backup    consistent SQLite snapshot + .env into a gitignored tarball
#
# Env overrides:
#   PLAYA_FQDN          default playa.lab980.com
#   PLAYA_BRANCH        default main
#   PLAYA_PORT          default: PORT from ./.env, else 8063
#   PLAYA_PROBE_TRIES   default 10 (one second apart)
#
# The app dir is wherever this script's checkout lives (normally
# /var/www/playa) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${PLAYA_FQDN:-playa.lab980.com}"
BRANCH="${PLAYA_BRANCH:-main}"
PROBE_TRIES="${PLAYA_PROBE_TRIES:-10}"
APP="playa"
ENV_FILE="$ROOT/.env"

# .env reading with shell builtins only, so a value never appears in any
# process's argv (/proc/<pid>/cmdline is world-readable). Nothing here logs a
# value; the callers only ask whether a key is present — except PORT, which
# is not a secret and is the one value this script needs.
env_file_get() {  # $1=file $2=KEY -> value on stdout ('' if absent). Never echo a secret result.
  local file="$1" key="$2" line val found=0
  [ -r "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"                 # ltrim
    case "$line" in ''|'#'*) continue;; esac
    case "$line" in
      export[[:space:]]*) line="${line#export}"; line="${line#"${line%%[![:space:]]*}"}";;
    esac
    case "$line" in "$key="*) ;; *) continue;; esac
    val="${line#*=}"
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}";;              # "quoted"
      \'*\') val="${val#\'}"; val="${val%\'}";;              # 'quoted'
      *)     val="${val%"${val##*[![:space:]]}"}";;          # bare: rtrim
    esac
    found=1                                                  # last one wins, like a shell
  done < "$file"
  [ "$found" -eq 1 ] && printf '%s' "$val"
  return 0
}
env_file_has() { [ -n "$(env_file_get "$1" "$2")" ]; }      # present AND non-empty

# The port is whatever provision-site assigned and wrote to .env (it picks the
# next free 8060+ port, checking live sockets AND existing vhosts) — never
# hardcoded, that is how you stomp another site. Precedence: PLAYA_PORT >
# .env PORT > 8063 (the registry's record for this site). src/env.js gives an
# existing process.env PORT precedence over .env, so the value handed to pm2
# below and the one in .env must agree — reading it from .env is what makes
# them agree.
PORT="${PLAYA_PORT:-$(env_file_get "$ENV_FILE" PORT)}"
PORT="${PORT:-8063}"

# The `pm2 start` argv that registers this app the FIRST time. Every later
# deploy is a `pm2 restart $APP` of that registration, but on a fresh box (or
# after `pm2 delete`) nothing is registered and restart fails.
#
# This reproduces the live registration on the droplet: server.js under node,
# fork mode, a 150M memory ceiling, NODE_ENV=production in the process env
# (see pm2_clean) — the shape ecosystem.config.js describes. Everything else
# (SESSION_SECRET, RESEND_API_KEY, DATABASE_URL, …) server.js reads from
# ./.env itself via src/env.js.
START_CMD=(server.js --name "$APP" --max-memory-restart 150M)

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
playa — operate playa.lab980.com (node app under pm2, behind nginx).

Usage:
  playa deploy [--no-build]    sync, npm ci, prisma migrate deploy, build, pm2 start/restart, probe, save
  playa redeploy [--no-build]  alias of deploy (the old name)
  playa restart                pm2 restart + probe
  playa logs [-n N]            tail pm2 logs
  playa status                 HEAD + pm2 + .env keys + local/public probe + cert
  playa backup                 SQLite snapshot + .env -> backup-playa-<ts>.tar.gz (gitignored)

The app reads its config from ./.env (see .env.example); PORT there is the
one provision-site assigned. Nothing comes from the shell that runs this.

Env: PLAYA_FQDN, PLAYA_BRANCH (default main), PLAYA_PORT (default: .env PORT, else 8063),
     PLAYA_PROBE_TRIES (default 10).
USAGE
}

# The app runs as root under pm2, and pm2 keeps one daemon, process list and
# dump PER HOME — root's is /root/.pm2. Run as anyone else, or as uid 0 with
# someone else's HOME (`su root` without `-`, `sudo` preserving HOME), and
# every pm2 call here talks to a different daemon: `status` says "not
# registered" while the site is up, and `deploy` starts a second copy.
need_root() {
  [ "$(id -u)" -eq 0 ] || die "$1 must run as root (the app's pm2 daemon is root's)."
  local rhome; rhome="$(getent passwd root | cut -d: -f6)"
  [ -n "${PM2_HOME:-}" ] || [ "${HOME:-}" = "$rhome" ] \
    || die "$1: HOME is '${HOME:-}' but root's home is $rhome — pm2 keys its daemon and dump off HOME, so this would talk to a different pm2. Use \`sudo -i\` or \`su -\` (or set PM2_HOME on purpose)."
}

# ---------------------------------------------------------------------------
# pm2. Every pm2 call goes through pm2_clean, which launches it from an EMPTY
# environment plus the handful of variables pm2 itself needs, PORT, and
# NODE_ENV=production. pm2 copies the environment of the `pm2 start` call
# into the process, and from there into ~/.pm2/dump.pm2 on save — so a plain
# `pm2 start` (or `pm2 restart --update-env`, which re-captures the shell on
# every deploy) would give whatever the calling shell carried an indefinite
# on-disk lifetime in the dump. The daemon itself keeps the environment of
# whichever call first spawned it, which is why jlist and logs go through
# here as well.
#
# PORT is handed in because it is not a secret and this script knows it
# (from .env, so the two agree — see above). NODE_ENV=production is passed
# explicitly because it is what the live registration carries and what
# ecosystem.config.js sets: src/env.js gives process.env precedence over
# .env, and magic-link mail only sends in production, so this is the one
# non-secret that must not depend on .env being complete. Everything else the
# app needs comes from ./.env, never from the shell that ran this script.
# ---------------------------------------------------------------------------
pm2_clean() {
  env -i PATH="$PATH" HOME="$HOME" ${PM2_HOME:+PM2_HOME="$PM2_HOME"} \
    ${TERM:+TERM="$TERM"} LANG=C.UTF-8 PORT="$PORT" NODE_ENV=production pm2 "$@"
}

# `pm2 jlist` is JSON only on a good day: pm2 writes chatter to STDOUT ahead
# of it — `[PM2] Spawning PM2 daemon…` when the daemon was down, `>>>> In-memory
# PM2 is out-of-date` after a pm2 upgrade. So the JSON is taken from the first
# line that starts one and parses; anything else is reported as unknown (exit
# 1), never guessed as "not registered" — deploy would answer that guess with
# a second `pm2 start` against a live app.
PM2_JSON='import json, sys
lines = sys.stdin.read().split("\n")
for i, line in enumerate(lines):
    if line[:1] in "[{":
        try:
            procs = json.loads("\n".join(lines[i:]))
        except ValueError:
            continue
        if isinstance(procs, list):
            json.dump(procs, sys.stdout); sys.exit(0)
sys.exit("no parseable JSON in pm2 jlist output")'
pm2_jlist() {   # -> JSON array on stdout; 1 with the reason on stderr
  local jl
  jl="$(pm2_clean jlist 2>/dev/null)" || { echo "pm2 jlist failed" >&2; return 1; }
  printf '%s' "$jl" | python3 -c "$PM2_JSON"
}

# "not registered", "<status>  mode=…", or "unknown (…)" with exit 1.
pm2_state() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf 'unknown (%s)\n' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
p = [x for x in json.load(sys.stdin) if x.get("name") == sys.argv[1]]
if not p: print("not registered"); raise SystemExit
e = p[0].get("pm2_env", {})
print("%s  mode=%s  restarts=%s  uptime-since=%s" % (
  e.get("status"), e.get("exec_mode"), e.get("restart_time"), e.get("pm_uptime")))' "$APP"
}

# Names of registered processes that are not online (empty = all online);
# exit 1 with the reason when the list cannot be read.
pm2_not_online() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf '%s' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
print(" ".join(x.get("name", "?") for x in json.load(sys.stdin)
               if x.get("pm2_env", {}).get("status") != "online"))'
}

save_if_online() {
  # pm2 save overwrites the dump with whatever is running right now, so a save
  # while anything is down persists a dump that comes back short on the next
  # reboot. The box rule (lab980 CLAUDE.md) is EVERY app online before a save,
  # not just this one; otherwise say so and leave the previous dump alone.
  local bad
  if ! bad="$(pm2_not_online)"; then
    warn "skipping pm2 save: cannot read the pm2 process list ($bad)"; return 0
  fi
  if [ -n "$bad" ]; then
    warn "not every pm2 process is online ($bad) — skipping pm2 save so the dump keeps its last good state. Run \`pm2 save\` yourself once they are."
    return 0
  fi
  pm2_clean save
}

check_env() {
  # server.js falls back to dev defaults for a missing key (a 'dev-only'
  # SESSION_SECRET, no mail), so a thin .env runs but runs wrong: warn.
  [ -f "$ENV_FILE" ] || { warn "$ENV_FILE is missing — provision-site seeds PORT there; copy .env.example and fill it in (DEPLOY.md §0)"; return 0; }
  env_file_has "$ENV_FILE" PORT || warn "$ENV_FILE has no PORT — using $PORT; provision-site normally seeds it"
  env_file_has "$ENV_FILE" SESSION_SECRET || warn "$ENV_FILE has no SESSION_SECRET — sessions are signed with the dev default"
  env_file_has "$ENV_FILE" RESEND_API_KEY || warn "$ENV_FILE has no RESEND_API_KEY — magic-link mail will not send"
}

probe() {
  # Local first, then public: a healthy app behind a broken vhost and a dead
  # app behind a fine vhost look identical from the outside, and telling them
  # apart is most of the diagnosis. Both are printed whatever happens.
  #
  # Pass/fail is the LOCAL port answering HTTP at all — any status code —
  # retried up to PROBE_TRIES times a second apart, since a Node app is often
  # still booting (here: opening Prisma) when pm2 first reports it online.
  # The public side only warns: it also depends on DNS and TLS.
  local lcode="" pcode i
  for ((i = 1; i <= PROBE_TRIES; i++)); do
    lcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:$PORT/api/health" || true)"
    [ "$lcode" != "000" ] || lcode=""   # curl's code for "never connected"
    [ -z "$lcode" ] || break
    sleep 1
  done
  pcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/api/health" || true)"
  [ "$pcode" != "000" ] || pcode=""
  printf 'local:     http://127.0.0.1:%s/api/health  ->  HTTP %s\n' "$PORT" "${lcode:-unreachable after $PROBE_TRIES tries}"
  printf 'public:    https://%s/api/health  ->  HTTP %s\n' "$FQDN" "${pcode:-unreachable}"
  [ -n "$lcode" ] || return 1
  case "$pcode" in
    ""|5*) warn "app answers locally but https://$FQDN/ is ${pcode:-unreachable} — look at nginx / DNS / TLS, not the app";;
  esac
}

cmd_deploy() {
  local DO_BUILD=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-build) DO_BUILD=0;;
      *) die "unknown deploy option: $1 (see --help)";;
    esac
    shift
  done
  need_root deploy
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."

  # Decide start-vs-restart BEFORE the sync: a first deploy that cannot start
  # should fail here, not after a hard reset and an npm ci it did not need.
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then deploy again."
  check_env

  local before after
  before="$(git rev-parse --short HEAD)"
  log "Syncing $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi

  # npm ci, not npm install: the lockfile is the deployed dependency set.
  # --omit=dev: prisma (the CLI) is a runtime dependency here, so it stays.
  log "npm ci --omit=dev"; npm ci --omit=dev
  # Migrations before the restart, so the new code never meets an old schema.
  # `prisma migrate deploy` is idempotent — a no-op when nothing is pending.
  log "npm run migrate:deploy"; npm run migrate:deploy
  if [ "$DO_BUILD" -eq 1 ]; then
    log "npm run build  (prisma generate + static-asset check)"; npm run build
  fi

  case "$state" in
    "not registered")
      log "pm2 start ${START_CMD[*]}  ($APP, first registration)"
      pm2_clean start "${START_CMD[@]}"
      state="$(pm2_state)" || die "pm2 start ran but the process list is unreadable — $state"
      [ "$state" != "not registered" ] \
        || die "pm2 start ran but nothing named $APP is registered — START_CMD must name it (--name $APP)."
      ;;
    *)
      log "pm2 restart $APP"
      pm2_clean restart "$APP"
      ;;
  esac
  probe || die "$APP is not answering on 127.0.0.1:$PORT — deploy failed, nothing saved. See: playa logs"
  save_if_online
  log "deployed: $(git rev-parse --short HEAD)  $(git log -1 --format=%s)"
}

cmd_restart() {
  [ $# -eq 0 ] || die "restart takes no options (see --help)"
  need_root restart
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then retry."
  [ "$state" != "not registered" ] || die "$APP is not registered with pm2 — nothing to restart. First start is: playa deploy"
  check_env
  log "pm2 restart $APP"
  pm2_clean restart "$APP"
  probe || die "$APP is not answering on 127.0.0.1:$PORT after restart. See: playa logs"
}
cmd_logs()    { pm2_clean logs "$APP" "$@"; }

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  printf 'pm2:       %s\n' "$(pm2_state || true)"
  if [ -f "$ENV_FILE" ]; then
    local k line=""
    for k in PORT APP_URL SESSION_SECRET RESEND_API_KEY MAIL_FROM ADMIN_EMAILS; do
      if env_file_has "$ENV_FILE" "$k"; then line="$line $k=present"; else line="$line $k=absent"; fi
    done
    printf '.env:     %s\n' "$line"
  else
    printf '.env:      (missing)\n'
  fi
  probe || true   # status reports, it does not judge — keep going to the cert
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

cmd_backup() {
  # A consistent SQLite snapshot via the backup API (a plain cp of a live WAL
  # database can be torn), archived with .env into a tarball beside the
  # checkout. The name is gitignored (backup-*.tar.gz), so deploy's hard
  # reset leaves it alone — move it off the box; it holds the secrets.
  [ $# -eq 0 ] || die "backup takes no options (see --help)"
  need_root backup
  cd "$ROOT"
  local ts out tmpdb
  ts="$(date +%Y%m%d-%H%M%S)"
  out="$ROOT/backup-$APP-$ts.tar.gz"
  tmpdb="$ROOT/data/backup-$ts.db"
  [ -f "$ROOT/data/playa.db" ] || die "no $ROOT/data/playa.db to back up"
  if command -v sqlite3 >/dev/null; then
    sqlite3 "$ROOT/data/playa.db" ".backup '$tmpdb'"
  else
    warn "sqlite3 not installed — copying the live database file instead of a consistent snapshot"
    cp "$ROOT/data/playa.db" "$tmpdb"
  fi
  ( umask 077
    if [ -f "$ENV_FILE" ]; then
      tar -czf "$out" -C "$ROOT" --transform "s|data/backup-$ts.db|data/playa.db|" "data/backup-$ts.db" .env
    else
      warn "no .env to include"
      tar -czf "$out" -C "$ROOT" --transform "s|data/backup-$ts.db|data/playa.db|" "data/backup-$ts.db"
    fi )
  rm -f "$tmpdb"
  log "wrote $out (mode 600; contains .env — move it off the box)"
}

case "${1:-}" in
  deploy|redeploy) shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  backup)  shift; cmd_backup "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
