# Copy to .env on the droplet (provision-site seeds PORT automatically).
# Local port this app listens on; nginx proxies <fqdn> -> 127.0.0.1:PORT.
PORT=8060
# Bind address (keep loopback; nginx is the only thing that should reach it).
HOST=127.0.0.1

# Public base URL, used to build magic-link URLs in emails.
APP_URL=https://playa.lab980.com

# Prisma SQLite database (path is relative to prisma/schema.prisma).
DATABASE_URL=file:../data/playa.db

# Secret for signing session cookies. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Resend transactional email (magic links, notifications). Get from resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Playa.Earth <onboarding@resend.dev>

NODE_ENV=production
